{
  "_comment": "Twin of probe_rate_limit.config.json with the pace colours named outright, so the probe can check that a configured colour wins over the palette chosen from the background.",
  "theme": "custom",
  "display": {
    "style": "powerline",
    "charset": "unicode",
    "colorCompatibility": "auto",
    "autoWrap": true,
    "lines": [
      {
        "segments": {
          "rateLimit": {
            "enabled": true,
            "show5h": true,
            "show7d": true
          }
        }
      }
    ]
  },
  "colors": {
    "custom": {
      "directory": {
        "bg": "#d0d7de",
        "fg": "#1f2328"
      },
      "git": {
        "bg": "#eaeef2",
        "fg": "#24292f"
      },
      "model": {
        "bg": "#ddf4ff",
        "fg": "#0550ae"
      },
      "rateLimit": {
        "bg": "#fff1c2",
        "fg": "#7d4e00",
        "paceUnder": "#0000ff",
        "paceOver": "#ff00ff"
      },
      "session": {
        "bg": "#eaeef2",
        "fg": "#24292f"
      },
      "block": {
        "bg": "#eaeef2",
        "fg": "#24292f"
      },
      "today": {
        "bg": "#eaeef2",
        "fg": "#24292f"
      },
      "week": {
        "bg": "#eaeef2",
        "fg": "#24292f"
      },
      "tmux": {
        "bg": "#d0d7de",
        "fg": "#1f2328"
      },
      "context": {
        "bg": "#dafbe1",
        "fg": "#1a7f37"
      },
      "metrics": {
        "bg": "#eaeef2",
        "fg": "#24292f"
      },
      "version": {
        "bg": "#eaeef2",
        "fg": "#24292f"
      },
      "warning": {
        "bg": "#cf222e",
        "fg": "#ffffff"
      }
    }
  }
}
